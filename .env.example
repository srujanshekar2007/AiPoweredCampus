# Supabase Auth (required for authenticated campus accounts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sensor-to-server token. Server only; do not expose as NEXT_PUBLIC_*.
SENSOR_INGEST_TOKEN=

# Keep server-only; required when using Supabase-backed sensor ingestion.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only issue photo analysis (website-help chatbot is local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
